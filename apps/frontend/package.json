    "@tanstack/vue-virtual": "^3.13.50",
    "@unhead/vue": "^3.4.3",
    "@vueuse/core": "^15.0.0",
    "ky": "^2.2.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "overrides": { "vitest": "5.0.5", "cookie@<0.7.0": "0.7.2", "js-yaml@>=4.0.0 <4.3.2": "4.3.2" },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
