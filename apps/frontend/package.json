{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=26.0.0" },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run type-check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
